{{- /*
  Sitemap principale.
  Rispetto a quella standard di Hugo esclude le pagine non indicizzabili
  (tag, /random/, sezione posts del tema: vedi partials/noindex.html)
  e toglie changefreq/priority, che Google ignora.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range where .Pages "Sitemap.Disable" "ne" true }}
    {{- if not (partial "noindex.html" .) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
